# Export these variables in a shell for a persistent installation.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=binance_utc
MYSQL_USER=kline
MYSQL_PASSWORD=
SYMBOLS=BTCUSDT,ETHUSDT
# Optional socket for a local MySQL instance
# MYSQL_UNIX_PORT=/path/to/mysql.sock
# The live collector appends a CSV by default. Use CSV_FILE= to disable it.
CSV_FILE=candles_utc.csv
